# ============================================================
# ELCODE Forge Server — Environment Configuration
# Copy this file to .env before starting docker-compose:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Forge Server Settings
# ------------------------------------------------------------
EFORGE_SERVER_HOST=0.0.0.0
EFORGE_SERVER_PORT=8080

# Production JWT Signing Secret (must be at least 32 characters)
EFORGE_JWT_SECRET=super_secret_jwt_token_for_forge_cloud_auth_32bytes_minimum

# Bootstrap Administrator API Key
EFORGE_ADMIN_API_KEY=forge_admin_api_key_default_bootstrap_12345

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info,forge_server=debug

# ------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_production_password_change_me
POSTGRES_DB=forge_db
POSTGRES_PORT=5432

# Database connection URL used by forge-server
# For SQLite (standalone): sqlite:///var/lib/eforge/forge.db
# For PostgreSQL (compose): postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
EFORGE_DATABASE_URL=postgres://forge:forge_production_password_change_me@postgres:5432/forge_db

# ------------------------------------------------------------
# MinIO S3 Object Storage Settings (Artifacts & Cache Retention)
# ------------------------------------------------------------
MINIO_ROOT_USER=forge_minio_admin
MINIO_ROOT_PASSWORD=forge_minio_secret_password_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------
# Web Dashboard Settings
# ------------------------------------------------------------
DASHBOARD_PORT=3000
